# Names/placeholders only. Worker secrets: wrangler secret put NAME --env staging
SUPABASE_URL=
# Accepts an enabled publishable key or legacy anon JWT.
SUPABASE_ANON_KEY=
# Server only: accepts a secret key or legacy service-role JWT.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_ENCRYPTION_KEY=
AUTH_ALIAS_DOMAIN=
OWNER_USER_ID=
ALLOWED_ORIGINS=
# Gemini free project only; pin model according to the verified official free-tier table
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=
AI_MODEL=
SCANNER_ENDPOINT=
SCANNER_API_KEY=
# Deployment-only secure environment settings, never Worker bindings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
