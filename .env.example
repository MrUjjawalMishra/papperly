# Restricted initial owner bootstrap; no public registration endpoint
OWNER_BOOTSTRAP_USER_ID=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_DISPLAY_NAME=

# Enable only after Supabase IP Address Forwarding is enabled; requires sb_secret key
AUTH_IP_FORWARDING=
